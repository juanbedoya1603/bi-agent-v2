APP_ENV=development
LOG_LEVEL=INFO

# Producción requiere acceso a OpenAI; como mínimo, OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_AGENTS_DISABLE_TRACING=true
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=true
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=true
MAX_SQL_ATTEMPTS_PER_TURN=3
RUN_LIVE_EVALS=0
RUN_SQL_LIVE_SMOKE=0

# Legacy / compatibilidad / smoke tests. Estas variables no son requeridas por
# el executor productivo ADLS basado en DuckDB.
ANALYTICS_DB_AUTH=entra_interactive
ANALYTICS_DB_HOST=
ANALYTICS_DB_PORT=1433
ANALYTICS_DB_NAME=
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_DRIVER=ODBC Driver 18 for SQL Server

# Producción requiere APP_DB_* para la App DB SQL Server independiente.
APP_DB_HOST=
APP_DB_PORT=1433
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_DRIVER=ODBC Driver 18 for SQL Server

# Producción requiere Azure Storage/ADLS para el executor DuckDB.
AZURE_STORAGE_CONNECTION_STRING=
ADLS_FILESYSTEM=agentbi
ADLS_BASE_PATH=TiendasOn

QUERY_TIMEOUT_SECONDS=600
MAX_RESULT_ROWS=200

SESSION_DB_PATH=tmp/bi_agent_sessions.sqlite3
WEB_ORIGIN=http://localhost:3000

BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
